{
  "name": "@flung.dev/connect",
  "version": "0.1.2",
  "description": "Let people connect and disconnect their social accounts from your page: a <flung-connect> web component and a React component for Flung, with no runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://flung.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flung-official/flung-sdk.git",
    "directory": "packages/connect"
  },
  "keywords": [
    "flung",
    "social-media",
    "oauth",
    "connect",
    "web-component",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
